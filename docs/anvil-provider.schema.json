{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/heurica-labs/anvil/main/docs/anvil-provider.schema.json",
  "title": "Anvil provider plugin",
  "description": "anvil-provider.json: describes a model provider for Anvil. See docs/PROVIDERS.md.",
  "type": "object",
  "required": [
    "spec",
    "id",
    "name",
    "type",
    "auth"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec": {
      "const": 1,
      "description": "Spec version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
      "not": {
        "enum": [
          "anvil",
          "experiential",
          "luna",
          "gemini",
          "chatgpt",
          "builtin",
          "local"
        ]
      },
      "description": "Unique short name. Models appear in Anvil as <id>/<model>."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "symbol": {
      "type": "string",
      "description": "SF Symbol name for menus."
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "enum": [
        "openai",
        "process"
      ]
    },
    "baseURL": {
      "type": "string",
      "format": "uri",
      "description": "openai: API root, e.g. https://api.example.com/v1 (https, or http for localhost)."
    },
    "chatPath": {
      "type": "string",
      "default": "chat/completions"
    },
    "modelsPath": {
      "type": "string",
      "default": "models",
      "description": "\"\" turns live model listing off."
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "process: run from the plugin folder, e.g. [\"python3\", \"provider.py\"]."
    },
    "auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "apiKey",
            "web"
          ]
        },
        "header": {
          "type": "string",
          "default": "Authorization"
        },
        "prefix": {
          "type": "string",
          "description": "Default \"Bearer \" for Authorization, \"\" for other headers."
        },
        "label": {
          "type": "string"
        },
        "keyURL": {
          "type": "string",
          "format": "uri"
        },
        "loginURL": {
          "type": "string",
          "format": "uri"
        },
        "domain": {
          "type": "string"
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localStorage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bearer": {
          "type": "string",
          "pattern": "^(localStorage|cookie):.+$"
        },
        "optional": {
          "type": "boolean",
          "description": "apiKey: the key may be left empty."
        },
        "manual": {
          "type": "boolean",
          "description": "web: wait for the owner to confirm instead of saving as soon as guest values exist."
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "name": {
            "type": "string"
          },
          "vision": {
            "type": "boolean"
          },
          "context": {
            "type": "integer"
          },
          "input": {
            "type": "number",
            "description": "USD per million input tokens."
          },
          "output": {
            "type": "number",
            "description": "USD per million output tokens."
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "stop": {
          "type": "boolean",
          "default": true
        },
        "reasoningEffort": {
          "type": "boolean",
          "default": false
        },
        "streaming": {
          "type": "boolean",
          "default": true
        },
        "streamUsage": {
          "type": "boolean",
          "default": true
        },
        "maxTokensField": {
          "type": "string",
          "default": "max_tokens"
        }
      }
    },
    "free": {
      "type": "boolean"
    },
    "body": {
      "type": "object",
      "description": "Extra fields merged into every chat request body, e.g. {\"enable_thinking\": false}."
    },
    "editableBaseURL": {
      "type": "boolean",
      "description": "Show a server URL field in Settings, for self-hosted proxies users deploy themselves."
    },
    "server": {
      "type": "object",
      "required": [
        "command",
        "ready"
      ],
      "description": "openai: a local server Anvil sets up once, starts on first use and stops on quit.",
      "properties": {
        "setup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ready": {
          "type": "string",
          "description": "localhost URL that answers when the server is up"
        },
        "startupTimeout": {
          "type": "number"
        },
        "setupTimeout": {
          "type": "number"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "openai"
          }
        }
      },
      "then": {
        "required": [
          "baseURL"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "process"
          }
        }
      },
      "then": {
        "required": [
          "command"
        ]
      }
    }
  ]
}
